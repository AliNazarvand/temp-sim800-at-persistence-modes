{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIM800 AT Command Inventory",
  "type": "object",
  "required": ["commands"],
  "additionalProperties": false,
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command","category","persistence_tracked"],
        "additionalProperties": false,
        "properties": {
          "command": {"type":"string","minLength":1},
          "category": {"type":"string","minLength":1},
          "persistence_tracked": {"type":"boolean"},
          "reason_not_tracked": {"type":"string"}
        }
      }
    }
  }
}